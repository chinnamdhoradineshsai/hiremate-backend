# HIREMATE BACKEND ENVIRONMENT CONFIGURATION (SUPABASE ARCHITECTURE)

# Supabase Credentials (Service Role Key must ONLY exist on FastAPI backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA Nemotron AI (Primary Reasoning Engine)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Tavily Research Provider
TAVILY_API_KEY=

# Admin Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPABASE_ADMIN_USER_ID=

# JWT & Security
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth (configured in Supabase dashboard)
GOOGLE_CLIENT_ID=

# Research Cache Expiry (in hours)
RESEARCH_CACHE_EXPIRY_HOURS=168

# Server Port & CORS
PORT=8000
FRONTEND_URL=http://localhost:5173
